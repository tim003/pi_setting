diff --git a/tests/coverage-gap.test.ts b/tests/coverage-gap.test.ts
new file mode 100644
index 0000000..ceb66f7
--- /dev/null
+++ b/tests/coverage-gap.test.ts
@@ -0,0 +1,163 @@
+import { describe, expect, it } from "vitest";
+
+import { type CoverageSpan, OM_OBSERVATIONS_RECORDED, contiguousCoverageEnd, ledgerCoverageSpans } from "../src/ledger/index.js";
+import { effectiveWatermarkId } from "../src/hooks/observer-trigger.js";
+import { observation, observationsRecordedEntry, textCustomMessage } from "./fixtures/session.js";
+
+/**
+ * Observers run concurrently over consecutive slices. When an earlier observer dies
+ * and a later one commits, the max-marker watermark jumps over the dead observer's
+ * slice and that span is never observed again — not even after a restart, because
+ * the committed marker already sits past it.
+ *
+ * Coverage therefore has to be tracked as spans and advanced only while they chain
+ * from the beginning of the branch.
+ */
+const branch = [
+	textCustomMessage("raw-1", "aaaa"),
+	textCustomMessage("raw-2", "bbbb"),
+	textCustomMessage("raw-3", "cccc"),
+	textCustomMessage("raw-4", "dddd"),
+];
+
+describe("contiguousCoverageEnd", () => {
+	it("does not advance past a hole left by a failed observer", () => {
+		// Observer A owned (start, raw-2] and died; observer B committed (raw-2, raw-4].
+		const spans = [{ fromId: "raw-2", upToId: "raw-4" }];
+		expect(contiguousCoverageEnd(branch, spans)).toBeUndefined();
+	});
+
+	it("advances to the end once the hole is filled", () => {
+		const spans = [
+			{ fromId: "raw-2", upToId: "raw-4" },
+			{ fromId: undefined, upToId: "raw-2" },
+		];
+		expect(contiguousCoverageEnd(branch, spans)).toBe("raw-4");
+	});
+
+	it("chains spans committed out of order", () => {
+		const spans = [
+			{ fromId: "raw-3", upToId: "raw-4" },
+			{ fromId: undefined, upToId: "raw-1" },
+			{ fromId: "raw-1", upToId: "raw-3" },
+		];
+		expect(contiguousCoverageEnd(branch, spans)).toBe("raw-4");
+	});
+
+	it("stops at the first hole even when later spans exist", () => {
+		const spans = [
+			{ fromId: undefined, upToId: "raw-1" },
+			{ fromId: "raw-3", upToId: "raw-4" },
+		];
+		expect(contiguousCoverageEnd(branch, spans)).toBe("raw-1");
+	});
+
+	it("treats legacy spans with no start marker as chaining from the beginning", () => {
+		// Ledgers written before coversFromId existed must keep their old watermark.
+		expect(contiguousCoverageEnd(branch, [{ fromId: undefined, upToId: "raw-3" }])).toBe("raw-3");
+	});
+
+	it("returns undefined when there is no coverage at all", () => {
+		expect(contiguousCoverageEnd(branch, [])).toBeUndefined();
+	});
+
+	it("ignores spans whose markers are not on this branch", () => {
+		const spans = [{ fromId: undefined, upToId: "raw-9" }];
+		expect(contiguousCoverageEnd(branch, spans)).toBeUndefined();
+	});
+
+	it("keeps the furthest end when spans overlap", () => {
+		const spans = [
+			{ fromId: undefined, upToId: "raw-3" },
+			{ fromId: "raw-1", upToId: "raw-2" },
+		];
+		expect(contiguousCoverageEnd(branch, spans)).toBe("raw-3");
+	});
+});
+
+describe("ledgerCoverageSpans", () => {
+	it("reads committed spans, defaulting the start when coversFromId is absent", () => {
+		const entries = [
+			branch[0],
+			branch[1],
+			observationsRecordedEntry("om-1", {
+				observations: [observation("2026-05-02T10:00:00")],
+				coversUpToId: "raw-2",
+			}),
+		];
+		expect(ledgerCoverageSpans(entries, OM_OBSERVATIONS_RECORDED)).toEqual([
+			{ fromId: undefined, upToId: "raw-2" },
+		]);
+	});
+
+	it("preserves coversFromId when the observer recorded one", () => {
+		const entries = [
+			...branch,
+			observationsRecordedEntry("om-1", {
+				observations: [observation("2026-05-02T10:00:00")],
+				coversUpToId: "raw-4",
+				coversFromId: "raw-2",
+			} as any),
+		];
+		expect(ledgerCoverageSpans(entries, OM_OBSERVATIONS_RECORDED)).toEqual([
+			{ fromId: "raw-2", upToId: "raw-4" },
+		]);
+	});
+
+	it("skips entries that carry no observations", () => {
+		const entries = [
+			...branch,
+			observationsRecordedEntry("om-1", { observations: [], coversUpToId: "raw-4" }),
+		];
+		expect(ledgerCoverageSpans(entries, OM_OBSERVATIONS_RECORDED)).toEqual([]);
+	});
+});
+
+describe("effectiveWatermarkId (dispatch + committed coverage together)", () => {
+	const spans = (...entries: [string, CoverageSpan][]) => new Map<string, CoverageSpan>(entries);
+
+	it("re-selects the dead observer's slice instead of trusting the later commit", () => {
+		// The exact shape of the reported failure: observer A died owning (start, raw-2],
+		// observer B committed (raw-2, raw-4].
+		const branchWithCommit = [
+			...branch,
+			observationsRecordedEntry("om-b", {
+				observations: [observation("2026-05-02T10:00:00")],
+				coversUpToId: "raw-4",
+				coversFromId: "raw-2",
+			} as any),
+		];
+		expect(effectiveWatermarkId({ dispatchedSpans: spans() }, branchWithCommit)).toBeUndefined();
+	});
+
+	it("does not re-dispatch a slice that is still in flight", () => {
+		const inFlight = spans(["run-a", { fromId: undefined, upToId: "raw-2" }]);
+		expect(effectiveWatermarkId({ dispatchedSpans: inFlight }, branch)).toBe("raw-2");
+	});
+
+	it("keeps a successful but empty run's span claimed, so it is not observed on a loop", () => {
+		// A run that legitimately found nothing appends no ledger entry; only the
+		// in-memory span stops it being selected again and again.
+		const claimed = spans(["run-a", { fromId: undefined, upToId: "raw-3" }]);
+		expect(effectiveWatermarkId({ dispatchedSpans: claimed }, branch)).toBe("raw-3");
+	});
+
+	it("releases the slice once the failed run's span is dropped", () => {
+		const claimed = spans(["run-a", { fromId: undefined, upToId: "raw-2" }]);
+		expect(effectiveWatermarkId({ dispatchedSpans: claimed }, branch)).toBe("raw-2");
+		claimed.delete("run-a");
+		expect(effectiveWatermarkId({ dispatchedSpans: claimed }, branch)).toBeUndefined();
+	});
+
+	it("bridges committed and in-flight spans into one chain", () => {
+		const branchWithCommit = [
+			...branch,
+			observationsRecordedEntry("om-a", {
+				observations: [observation("2026-05-02T10:00:00")],
+				coversUpToId: "raw-2",
+			}),
+		];
+		const inFlight = spans(["run-b", { fromId: "raw-2", upToId: "raw-4" }]);
+		expect(effectiveWatermarkId({ dispatchedSpans: inFlight }, branchWithCommit)).toBe("raw-4");
+	});
+})
