+/**
+ * A half-open range of source entries `(fromId, upToId]` that some observer covered.
+ * `fromId === undefined` means "from the start of the branch", which is also how
+ * ledger entries written before `coversFromId` existed are read.
+ */
+export type CoverageSpan = { fromId: string | undefined; upToId: string };
+
+/** Committed coverage, as spans rather than bare end markers. */
+export function ledgerCoverageSpans(entries: Entry[], customType: MemoryCustomType): CoverageSpan[] {
+	const spans: CoverageSpan[] = [];
+	for (const entry of entries) {
+		if (!isValidCoverageEntry(entry, customType)) continue;
+		const data = entry.data as { coversUpToId: string; coversFromId?: unknown };
+		spans.push({
+			fromId: typeof data.coversFromId === "string" ? data.coversFromId : undefined,
+			upToId: data.coversUpToId,
+		});
+	}
+	return spans;
+}
+
+/**
+ * End of the coverage that chains unbroken from the start of the branch.
+ *
+ * Observers run concurrently over consecutive slices, so a failed observer leaves a
+ * hole that a later, successful observer would otherwise hide: taking the maximum end
+ * marker advances the watermark past the dead observer's slice, and because the
+ * committed marker is durable, that span is never re-observed even after a restart.
+ * Requiring contiguity makes the watermark stall at the hole until it is filled.
+ */
+export function contiguousCoverageEnd(entries: Entry[], spans: readonly CoverageSpan[]): string | undefined {
+	const idToIndex = entryIndexById(entries);
+	const resolved = spans
+		.map((span) => ({
+			fromIndex: span.fromId === undefined ? -1 : (idToIndex.get(span.fromId) ?? Number.NaN),
+			upToIndex: idToIndex.get(span.upToId) ?? Number.NaN,
+			upToId: span.upToId,
+		}))
+		// A span naming entries that are not on this branch (a rewound /tree, say) cannot
+		// be placed, so it must not be allowed to bridge a gap.
+		.filter((span) => Number.isInteger(span.fromIndex) && Number.isInteger(span.upToIndex));
+
+	let cursorIndex = -1;
+	let cursorId: string | undefined;
+	// Spans commit out of order, so sweep repeatedly until nothing extends the chain.
+	for (let advanced = true; advanced; ) {
+		advanced = false;
+		for (const span of resolved) {
+			if (span.fromIndex <= cursorIndex && span.upToIndex > cursorIndex) {
+				cursorIndex = span.upToIndex;
+				cursorId = span.upToId;
+				advanced = true;
+			}
+		}
+	}
+	return cursorId;
+}
+
