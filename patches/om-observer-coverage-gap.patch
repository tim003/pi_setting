+/**
+ * Effective watermark = end of the coverage chaining unbroken from the start of the
+ * branch, counting both committed spans and spans already handed to observers.
+ *
+ * Contiguity is what stops a failed observer's slice from being skipped: a later
+ * sibling's success cannot bridge the hole, so the next dispatch re-selects it.
+ */
+export function effectiveWatermarkId(
+	runtime: { dispatchedSpans: ReadonlyMap<string, CoverageSpan> },
+	branch: Entry[],
+): string | undefined {
+	return contiguousCoverageEnd(branch, [
+		...ledgerCoverageSpans(branch, OM_OBSERVATIONS_RECORDED),
+		...runtime.dispatchedSpans.values(),
+	]);
 }
 
